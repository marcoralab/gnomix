rule Compress:
    input: gchunkdir + '/query_file_phased.vcf'
    output:
        vcf = gchunkdir + '/{dataset}_chr{chrom}.vcf.gz',
        tbi = gchunkdir + '/{dataset}_chr{chrom}.vcf.gz.tbi'
    threads: 2
    resources:
        mem_mb = 4000,
        walltime = '24:00'
    conda: "envs/bcftools.yaml"
    shell:
        '''
bcftools view -Oz -o {output.vcf} {input}
bcftools index -tf {output.vcf}
'''

gchunkdirp = 'output/chunked/{{dataset}}_{{build}}_chr{{chrom}}_chunk{chunk}'

def aggregate(wildcards, fname):
    checkpoint_output = checkpoints.sample_list_split.get(**wildcards).output[0]
    chunks = glob_wildcards(checkpoint_output + "/split.{chunk}").chunk
    # ins = {
    #     "vcf": expand(gchunkdir + '/{{dataset}}_chr{{chrom}}.vcf.gz', chunk=chunks),
    #     "fb": expand(gchunkdir + '/query_results.fb', chunk=chunks),
    #     "msp": expand(gchunkdir + '/query_results.msp', chunk=chunks)
    # }
    # return ins
    return expand(gchunkdirp + fname, chunk=chunks)

rule merge_gnomix:
    input:
        vcf = lambda wc: aggregate(wc, '/{{dataset}}_chr{{chrom}}.vcf.gz'),
        tbi = lambda wc: aggregate(wc, '/{{dataset}}_chr{{chrom}}.vcf.gz.tbi'), 
        fb = lambda wc: aggregate(wc, '/query_results.fb'), 
        msp = lambda wc: aggregate(wc, '/query_results.msp') 
    output:
        vcf = 'output/merged/{dataset}_{build}_chr{chrom}.vcf.gz',
        tbi = 'output/merged/{dataset}_{build}_chr{chrom}.vcf.gz.tbi',
        msp = 'output/merged/{dataset}_{build}_chr{chrom}.msp',
        fb = 'output/merged/{dataset}_{build}_chr{chrom}.fb',
        tmp = temp('output/merged/{dataset}_{build}_chr{chrom}.tmp')
    threads: 2
    resources:
        mem_mb = 4000,
        walltime = '24:00'
    conda: "envs/gnomad_merge.yaml"
    shell:
        r'''
bcftools merge -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}

tmpfile={output.tmp}
out_msp={output.msp}
out_fb={output.fb}

msps=({input.msp}) # make array of inputs
msp_first="${{msps[0]}}"
cp "$msp_first" "$out_msp" # copy first input to output
msps=("${{msps[@]:1}}") # delete first input from array

for msp in ${{msps[@]}}; do
  if ! diff -q <(cut -f1-6 "$msp_first") <(cut -f1-6 "$msp"); then
    echo "$msp has different variant ranges than the first chunk"
    exit 1
  fi
  paste "$out_msp" <(cut -f1-6 --complement $msp) > "$tmpfile"
  cp "$tmpfile" "$out_msp"
  nrow=$(cat "$out_msp" | tail -n +3 | wc -l)
  ncol=$(sed -n '2{{s/\t/\n/g;p;q}}' "$out_msp" | tail -n +7 | wc -l)
  echo $msp "$nrow" rows, "$ncol" columns
done

rm "$tmpfile"

fbs=({input.fb}) # make array of inputs
fb_first="${{fbs[0]}}"
cp "$fb_first" "$out_fb" # copy first input to output
fbs=("${{fbs[@]:1}}") # delete first input from array

for fb in ${{fbs[@]}}; do
  if ! diff -q <(cut -f1-4 "$fb_first") <(cut -f1-4 "$fb"); then
    echo "$msp has different variant ranges than the first chunk"
    #exit 1
  fi
  paste $out_fb <(cut -f1-4 --complement $fb) > "$tmpfile"
  cp "$tmpfile" "$out_fb"
  nrow=$(cat "$out_fb" | tail -n +3 | wc -l)
  ncol=$(sed -n '2{{s/\t/\n/g;p;q}}' "$out_fb" | tail -n +5 | wc -l)
  echo $fb: "$nrow" rows, "$ncol" columns
done

get_head () {{
  awk 'NR == 1 {{a[$0]; print; next}} FNR == 1 && !($0 in a) \
    {{print "Header comment different"; exit 1}}' $@
}}

replace_head () {{ sed -i "1 s|^.*$|$1|" $2 ; }}

header_fb="$(get_head {input.fb})"
header_msp="$(get_head {input.msp})"

replace_head "$header_fb" "$out_fb"
replace_head "$header_msp" "$out_msp"
'''

rule Concatenate:
    input:
        vcf = expand('output/merged/{{dataset}}_{{build}}_chr{chrom}.vcf.gz', chrom=CHROMS),
        tbi = expand('output/merged/{{dataset}}_{{build}}_chr{chrom}.vcf.gz.tbi', chrom=CHROMS),
    output:
        vcf = 'output/{dataset}_{build}_chrall.vcf.gz',
        tbi = 'output/{dataset}_{build}_chrall.vcf.gz.tbi'
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '24:00'
    conda: "envs/bcftools.yaml"
    shell:
        r'''
bcftools concat -Oz -o {output.vcf} --threads 2 {input.vcf}
bcftools index -tf {output.vcf}
'''

rule Merge:
    input:
        vcf = expand('output/{dataset}_{build}_chrall.vcf.gz', zip, dataset=DATASETS, build=BUILD),
        tbi = expand('output/{dataset}_{build}_chrall.vcf.gz.tbi', zip, dataset=DATASETS, build=BUILD)
    output:
        vcf = "output/merged.vcf.gz",
        tbi = "output/merged.vcf.gz.tbi"
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '24:00'
    conda: "envs/bcftools.yaml"
    shell:
        r'''
bcftools merge -m none -Oz -o {output.vcf} --threads 2 {input.vcf}
bcftools index -tf {output.vcf}
'''
