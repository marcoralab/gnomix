rule gnomix_model:
    input:
        query = "intermediate/{dataset}.{build}.chr{chrom}.modelfit.vcf.gz",
        genetic_map = rules.geneticMapGnomix.output,
        reference = lambda wc: expand("reference_proc/{refname}.{{build}}.chr{{chrom}}.filtered_{{dataset}}.vcf.gz", refname=ref_name[wc['build']]),
        sample_map =  lambda wc: ref_pops[wc['build']],
        config = lambda wc: gconfig_local_dict[wc["dataset"]]
    output:
        'output/models/{dataset}_{build}_chr{chrom}/models/model_chm_{chrom}/model_chm_{chrom}.pkl'
    params:
        output_folder = 'output/models/{dataset}_{build}_chr{chrom}',
        phase = 'False', #True or False
    threads: 40
    resources:
        mem_mb = 8000,
        walltime = '140:00'
    container: "docker://befh/gnomix:v2"
    shell:
        '''
python3 /gnomix/gnomix.py {input.query} {params.output_folder} \
  {wildcards.chrom} {params.phase} \
  {input.genetic_map} {input.reference} {input.sample_map} \
  {input.config}
'''

