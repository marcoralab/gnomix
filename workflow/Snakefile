rule get_refsamp:
    input: lambda wc: ref_pops[wc["build"]]
    output: "reference_proc/{refname}.{build}.fromsmap.samplist" 
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '96:00'
    shell: r'''awk -F '\t' 'NR > 1 {{print $1}}' {input} > {output}'''

def choose_vcf_ref(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('phased', False):
        assert intype == 'vcf', 'plink files cannot be phased and bcf files are not yet supported'
        return conf[ds]['infile']
    elif conf[ds].get('impute', False):
        assert input_type_dict[ds] != 'vcf', 'cannot impute vcf yet'
        return 'output/imputation/data/by_chrom/{dataset}_chr{chrom}_filtered.vcf.gz',
    elif wc['build'] == 'hg38':
        return "intermediate/{dataset}.{build}.chr{chrom}.forgnomix.vcf.gz"
    elif intype == 'vcf' and re.match(r'.+\{chrom\}', conf[ds]['infile']):
        return rules.vcf_presplit.output.vcf
    else:
        return rules.vcf.output.vcf

rule filter_ref:
    input:
      ref = rules.makeref.output,
      samp = choose_vcf_ref,
      ref_samples = lambda wc: rules.process_admixture.output.samplist if wc['build'] == "hg38" else rules.get_refsamp.output
    output: "reference_proc/{refname}.{build}.chr{chrom}.filtered_{dataset}.vcf.gz"
    conda: "envs/bcftools.yaml"
    threads: 4
    resources:
        mem_mb = 1024,
        walltime = '96:00'
    shell:
        '''
bcftools view --regions-file {input.samp} --samples-file {input.ref_samples} --force-samples -Oz -o {output} {input.ref}
bcftools index -f {output}
'''

rule eagle:
    input:
        target = rules.bcf.output,
        ref = lambda wc: expand("reference_proc/{refname}.{{build}}.chr{{chrom}}.bcf", refname=ref_name[wc['build']])
    output: "intermediate/{dataset}.{build}.chr{chrom}.eagle2.vcf.gz"
    params:
        outstem = "intermediate/{dataset}.{build}.chr{chrom}.eagle2"
    log: "logs/{dataset}_{build}_chr{chrom}.eagle.log"
    threads: 20
    resources:
        mem_mb = 4000,
        walltime = '96:00'
    container: 'docker://befh/eagle:v2.4.1'
    shell:
        '''
eagle --vcfTarget={input.target} --vcfRef={input.ref} \
  --geneticMapFile=/tables/genetic_map_{wildcards.build}_withX.txt.gz \
  --outPrefix={params.outstem} --numThreads={threads} --vcfOutFormat=z \
  2>&1 | tee {log}
'''

rule geneticMapGnomix:
    input: HTTP.remote("https://storage.googleapis.com/broad-alkesgroup-public/Eagle/downloads/tables/genetic_map_{build}_withX.txt.gz") if iconnect else ''
    output: "reference_proc/genetic_map_{build}_withX.gmap"
    resources:
        mem_mb = 1000,
        time_min = 30
    shell:
        r'''
zcat {input} | \
  awk 'BEGIN {{OFS="\t"; print "#chromosome\tposition\tGenetic_Map(cM)"}} NR > 1 {{print $1,$2,$4}}' \
  > {output}
'''

def choose_vcf_gnomix(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('impute', False):
        assert input_type_dict[ds] != 'vcf', 'cannot impute vcf yet'
        return 'output/imputation/data/by_chrom/{dataset}_chr{chrom}_filtered.vcf.gz',
    elif conf[ds].get('phased', False):
        assert intype == 'vcf', 'plink files cannot be phased and bcf files are not yet supported'
        return choose_vcf_general(wc)
    elif wc['build'] == 'hg38':
        return "intermediate/{dataset}.hg38.chr{chrom}.shapeit5.vcf.gz"
    else:
        return "intermediate/{dataset}.{build}.chr{chrom}.eagle2.vcf.gz"
    
rule vcf_gnomix:
    input: choose_vcf_gnomix
    output: "intermediate/{dataset}.{build}.chr{chrom}.forgnomix.vcf.gz",
    resources:
        mem_mb = 4000,
        time_min = 240
    shell: '''
ln -rs {input} {output}
'''

rule sample_list:
    input: lambda wc: expand("intermediate/{{dataset}}.{build}.chr{chrom}.forgnomix.vcf.gz", chrom=CHROMS, build=build_dict[wc["dataset"]])
    output: "intermediate/sample_lists/{dataset}_all.txt",
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 30
    shell: "bcftools query -l {input[0]} > {output}"

checkpoint sample_list_split:
    input: ancient(rules.sample_list.output)
    output: directory("intermediate/sample_lists/split_{dataset}")
    params:
        splitstem = "intermediate/sample_lists/split_{dataset}/split."
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 30
    shell: "mkdir -p {output} && split -l 100 -a 4 -d {input} {params.splitstem}"

rule splits:
    input:
        sample_list = "intermediate/sample_lists/split_{dataset}/split.{chunk}",
        vcf = rules.vcf_gnomix.output
    output:
        vcf = temp("intermediate/{dataset}.{build}.chr{chrom}.chunk{chunk}.vcf.gz"),
        tbi = temp("intermediate/{dataset}.{build}.chr{chrom}.chunk{chunk}.vcf.gz.tbi"),
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 960
    shell:
        '''
bcftools view --samples-file {input.sample_list} -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}
'''

rule vcf_model_fit:
    input:
        sample_list = rules.sample_list.output,
        vcf = rules.vcf_gnomix.output
    output:
        sample_list = temp("intermediate/{dataset}.{build}.chr{chrom}.modelfit.samples"),
        vcf = temp("intermediate/{dataset}.{build}.chr{chrom}.modelfit.vcf.gz"),
        tbi = temp("intermediate/{dataset}.{build}.chr{chrom}.modelfit.vcf.gz.tbi"),
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 960
    shell:
        '''
head -n4 {input.sample_list} > {output.sample_list}
bcftools view --samples-file {output.sample_list} -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}
'''

