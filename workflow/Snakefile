"""

rule Sample_Flip:
    input:
        bim = "intermediate/{dataset}" + '.bim',
        bed = "intermediate/{dataset}" + '.bed',
        fam = "intermediate/{dataset}" + '.fam',
        fasta = expand("reference/human_g1k_{gbuild}.fasta", gbuild=BUILD)
    output:
        multiext("intermediate/{dataset}_flipped", ".bim", ".bed", ".fam")
    params:
        stem = "intermediate/{dataset}"
    resources:
        mem_mb = 10000,
        time_min = 30
    container: 'docker://befh/flippyr:0.5.3'
    shell: "flippyr -p {input.fasta} -o {params.stem} {input.bim}"

