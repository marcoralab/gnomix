rule download_tg_fa:
    input: fasta_remote
    output:
        "reference/human_{source}_{gbuild}.fasta",
        "reference/human_{source}_{gbuild}.fasta.fai"
    params:
        md5 = lambda wc: fasta_md5(wc)
    resources:
        mem_mb = 10000,
        time_min = 30
    conda: 'envs/bcftools.yaml'
    localrule: True
    #cache: True
    shell:
        '''
md5sum -c <(echo {params.md5} {input[0]})
if [[ "{input[0]}" == *.gz ]]; then
  zcat {input[0]} > {output[0]} && rstatus=0 || rstatus=$?; true
  if [ $rstatus -ne 2 && $rstatus -ne 0 ]; then
    exit $rstatus
  fi
else
  cp {input[0]} {output[0]}
fi
samtools faidx {output[0]}
'''

def get_intype(wc):
    intype_ =  wc['inputtype']
    if intype_ == 'bplink':
        return 'bfile'
    elif intype_ == 'plink':
        return 'file'
    else:
        raise Exception('Invalid input type')

def get_infile(wc):
    intype_ = wc['inputtype']
    stem = input_dict[wc['dataset']]
    if intype_ == 'bplink':
        return multiext(stem, ".bed", ".bim", ".fam")
    elif intype_ == 'plink':
        return multiext(stem, ".ped", ".map")
    else:
        raise Exception('Invalid input type')

rule plink_filter:
    input: get_infile
    output: temp(multiext("intermediate/start/{dataset}.{build}.from{inputtype}", ".bed", ".bim", ".fam"))
    params:
        ins = lambda wc: input_dict[wc['dataset']],
        out = "intermediate/start/{dataset}.{build}.from{inputtype}",
        filt = lambda wc: filter_dict[wc['dataset']],
        ftype = get_intype
    resources:
        mem_mb = 10000,
        time_min = 30
    conda: "envs/plink.yaml"
    shell:
        """
plink --{params.ftype} {params.ins} {params.filt} --make-bed --out {params.out}
"""

def preimpute_files(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    stem = expand("intermediate/start/{dataset}.{build}.from{inputtype}",
        inputtype=intype, build=impute_build, dataset=ds)[0]
    return {x: stem + '.' + x for x in ['bed', 'bim', 'fam']}

rule link_impute:
    input: unpack(preimpute_files)
    output:
        bed = "intermediate/impute_start/{dataset}.bed",
        bim = "intermediate/impute_start/{dataset}.bim",
        fam = "intermediate/impute_start/{dataset}.fam"
    resources:
        mem_mb = 1000,
        time_min = 30
    shell:
        '''
cp {input.bed} {output.bed}
cp {input.bim} {output.bim}
cp {input.fam} {output.fam}
'''
    

