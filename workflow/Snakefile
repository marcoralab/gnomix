'''

rule vcf_model_fit:
    input:
        sample_list = rules.sample_list.output,
        vcf = rules.eagle.output
    output:
        sample_list = temp("intermediate/{dataset}_chr{chrom}_phased_modelfit.samples"),
        vcf = temp("intermediate/{dataset}_chr{chrom}_phased_modelfit.vcf.gz"),
        tbi = temp("intermediate/{dataset}_chr{chrom}_phased_modelfit.vcf.gz.tbi"),
    conda: "envs/bcftools.yaml"
    threads: 4
    resources:
        mem_mb = 4000,
        time_min = 30
    shell:
        '''
head -n4 {input.sample_list} > {output.sample_list}
bcftools view --samples-file {output.sample_list} -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}
'''

rule gnomix_model:
    input:
        query = "intermediate/{dataset}_chr{chrom}_phased_modelfit.vcf.gz",
        genetic_map = rules.geneticMapGnomix.output,
        reference = expand("reference_proc/1000g.{build}.chr{{chrom}}.filtered_{{dataset}}.vcf.gz", build=BUILD),
        sample_map = HTTP.remote(reporoot + "/demo/data/1000g.smap") if iconnect else '',
        config = gconfig
    output:
        'output/models/{dataset}_chr{chrom}/models/model_chm_{chrom}/model_chm_{chrom}.pkl'
    params:
        output_folder = 'output/models/{dataset}_chr{chrom}',
        phase = 'False', #True or False
    threads: 40
    resources:
        mem_mb = 4000,
        walltime = '140:00'
    container: "docker://befh/gnomix:v2"
    shell:
        '''
python3 /gnomix/gnomix.py {input.query} {params.output_folder} \
  {wildcards.chrom} {params.phase} \
  {input.genetic_map} {input.reference} {input.sample_map} \
  {input.config}
'''

