# Recode sample plink file to vcf
rule plink_vcf:
    input:
        bed = "intermediate/{dataset}.{build}.from{inputtype}_flipped.bed",
        bim = "intermediate/{dataset}.{build}.from{inputtype}_flipped_ChromPos.bim",
        fam = "intermediate/{dataset}.{build}.from{inputtype}_flipped.fam"
    output: temp("intermediate/{dataset}.{build}.from{inputtype}.plink_contigs.vcf.gz")
    params:
        out = "intermediate/{dataset}.{build}.from{inputtype}.plink_contigs"
    threads: 40
    resources:
        mem_mb = 4000,
        time_min = 1440
    conda: "envs/plink2.yaml"
    shell:
        '''
plink2 --bed {input.bed} --bim {input.bim} --fam {input.fam} --recode vcf bgz \
  --real-ref-alleles --out {params.out} --threads {threads} --memory 160000
'''

rule rename_vcf:
    input:
        vcf = rules.plink_vcf.output,
        mapping = rules.rename_chrom.output.mapping
    output: temp("intermediate/{dataset}.{build}.from{inputtype}.vcf.gz")
    threads: 4
    resources:
        mem_mb = 2048,
        time_min = 2880
    conda: "envs/bcftools.yaml"
    shell:
        '''
bcftools annotate --rename-chrs {input.mapping} -Oz -o {output} --threads {threads} {input.vcf}
'''

def choose_vcf_initial(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('impute', False):
        raise Exception("Phasing not needed after imputation")
    # elif conf[ds].get('phased', False):
    #     raise Exception("Phasing not needed")
    elif intype == 'bcf':
        raise Exception("BCF not yet supported")
    elif intype == 'vcf':
        return conf[ds]['infile']
    else:
        return expand("intermediate/{{dataset}}.{{build}}.from{inputtype}.vcf.gz",
            inputtype = intype)

def choose_filter_vcf_initial(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('impute', False):
        raise Exception("Phasing not needed after imputation")
    # elif conf[ds].get('phased', False):
    #     raise Exception("Phasing not needed")
    elif intype == 'bcf':
        raise Exception("BCF not yet supported")
    elif intype == 'vcf':
        return filter_dict[ds]
    else:
        return ''

rule vcf:
    input: choose_vcf_initial
    output:
        vcf = temp("intermediate/{dataset}.{build}.allchrom.vcf.gz"),
        tbi = "intermediate/{dataset}.{build}.allchrom.vcf.gz.tbi"
    params:
        filt = choose_filter_vcf_initial
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 8600
    shell: '''
filt="{params.filt}"
if [[ -z "${{filt// }}" ]]; then
  cp {input} {output.vcf}
else
  bcftools view {params.filt} -Oz -o {output.vcf} {input}
fi
bcftools index -t {output.vcf}
'''

rule vcf_split:
    input:
        vcf = rules.vcf.output.vcf,
        tbi = rules.vcf.output.tbi
    output:
        vcf = temp("intermediate/{dataset}.{build}.chr{chrom}.pipesplit.vcf.gz"),
        tbi = "intermediate/{dataset}.{build}.chr{chrom}.pipesplit.vcf.gz.tbi"
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 16000,
        time_min = 8600
    shell: '''
bcftools view -r {wildcards.chrom} -Oz -o {output.vcf} {input.vcf} && \
sleep 5 && \
bcftools index -t {output.vcf}
'''

rule vcf_presplit:
    input: choose_vcf_initial
    output:
        vcf = temp("intermediate/{dataset}.{build}.chr{chrom}.perchrom.vcf.gz"),
        tbi = "intermediate/{dataset}.{build}.chr{chrom}.perchrom.vcf.gz.tbi"
    params:
        filt = lambda wc: filter_dict[wc['dataset']],
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 8600
    shell: '''
filt="{params.filt}"
if [[ -z "${{filt// }}" ]]; then
  ln -rs {input} {output.vcf}
else
  bcftools view {params.filt} -Oz -o {output.vcf} {input}
fi
bcftools index -t {output.vcf}
'''

def choose_vcf_general(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if intype == 'vcf' and re.match(r'.+\{chrom\}', conf[ds]['infile']):
        return rules.vcf_presplit.output.vcf
    else:
        return rules.vcf_split.output.vcf

def choose_tbi_general(wc):
    return choose_vcf_general(wc) + '.tbi'

rule bcf:
    input:
        vcf = choose_vcf_general,
        tbi = choose_tbi_general,
        fasta = lambda wc: ref_fasta[wc["build"]]
    output: "intermediate/{dataset}.{build}.chr{chrom}.bcf"
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 1440
    shell:
        """
bcftools norm -Ob -o {output} -d none -f {input.fasta} {input.vcf} && \
bcftools index {output}
"""

