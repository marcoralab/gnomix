'''

rule Compress:
    input: gchunkdir + '/query_file_phased.vcf'
    output:
        vcf = temp(gchunkdir + '/{dataset}_chr{chrom}.vcf.gz'),
        tbi = gchunkdir + '/{dataset}_chr{chrom}.vcf.gz.tbi'
    threads: 2
    resources:
        mem_mb = 4000,
        walltime = '4:00'
    conda: "envs/bcftools.yaml"
    shell:
        '''
bcftools view -Oz -o {output.vcf} {input}
bcftools index -tf {output.vcf}
'''

gchunkdirp = 'output/chunked/{{dataset}}_chr{{chrom}}_chunk{chunk}'

def aggregate(wildcards, fname):
    #import ipdb; ipdb.set_trace()
    checkpoint_output = checkpoints.sample_list_split.get(**wildcards).output
    chunks = glob_wildcards(checkpoint_output).chunk
    # ins = {
    #     "vcf": expand(gchunkdir + '/{{dataset}}_chr{{chrom}}.vcf.gz', chunk=chunks),
    #     "fb": expand(gchunkdir + '/query_results.fb', chunk=chunks),
    #     "msp": expand(gchunkdir + '/query_results.msp', chunk=chunks)
    # }
    # return ins
    return expand(gchunkdir + fname, chunk=chunks)

rule merge_gnomad:
    input:
        vcf = lambda wc: aggregate(wc, '/{{dataset}}_chr{{chrom}}.vcf.gz'), 
        fb = lambda wc: aggregate(wc, '/query_results.fb'), 
        msp = lambda wc: aggregate(wc, '/query_results.msp') 
    output:
        vcf = 'output/merged/{dataset}_chr{chrom}.vcf.gz',
        tbi = 'output/merged/{dataset}_chr{chrom}.vcf.gz.tbi',
        msp = 'output/merged/{dataset}_chr{chrom}.msp',
        fb = 'output/merged/{dataset}_chr{chrom}.fb',
    threads: 2
    resources:
        mem_mb = 4000,
        walltime = '4:00'
    conda: "envs/gnomad_merge.yaml"
    shell:
        r'''
bcftools merge -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}

msps=({input.msp}) # make array of inputs
cp "${{msps[0]}}" {output.msp} # copy first input to output
msps=("${{msps[@]:1}}") # delete first input from array

for msp in ${{msps[@]}}; do
  mlr --tsv --skip-comments-with "#Subpopulation" join \
   -j '#chm,spos,epos,sgpos,egpos,n snps' \
   -f {output.msp} $msp > {output.msp}
done

fbs=({input.fb}) # make array of inputs
cp "${{fbs[0]}}" {output.fb} # copy first input to temp output
fbs=("${{fbs[@]:1}}") # delete first input from array

for fb in ${{fbs[@]}}; do
  mlr --tsv --skip-comments join \
   -j 'chromosome,physical_position,genetic_position,genetic_marker_index' \
   -f {output.fb} $fb > {output.fb}
done

get_head () {{
  awk 'NR == 1 {{a[$0]; print; next}} FNR == 1 && !($0 in a) \
    {{print "Header comment different"; exit 1}}' $@
}}

append_head () {{ sed -i "1s/^/$1\n/" $2 ; }}

append_head "$(get_head {input.fb})" {output.fb}
append_head "$(get_head {input.msp})" {output.msp}
'''

rule Concatenate:
    input:
        vcf = expand('output/merged/{{dataset}}_chr{chrom}.vcf.gz', chrom=CHROMS),
        tbi = expand('output/merged/{{dataset}}_chr{chrom}.vcf.gz.tbi', chrom=CHROMS),
    output:
        vcf = 'output/{dataset}_chrall.vcf.gz',
        tbi = 'output/{dataset}_chrall.vcf.gz.tbi'
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '4:00'
    conda: "envs/bcftools.yaml"
    shell:
        r'''
bcftools concat -Oz -o {output.vcf} --threads 2 {input.vcf}
bcftools index -tf {output.vcf}
'''

rule Merge:
    input:
        vcf = expand('output/{dataset}_chrall.vcf.gz', dataset=DATASETS),
        tbi = expand('output/{dataset}_chrall.vcf.gz.tbi', dataset=DATASETS)
    output:
        vcf = "output/merged.vcf.gz",
        tbi = "output/merged.vcf.gz.tbi"
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '4:00'
    conda: "envs/bcftools.yaml"
    shell:
        r'''
bcftools merge -m none -Oz -o {output.vcf} --threads 2 {input.vcf}
bcftools index -tf {output.vcf}
'''
