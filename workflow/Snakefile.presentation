rule merge_eur:
    input: ref_pops
    output: "reference_proc/{refname}.mergedeur.smap"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 2
    shell: r'''awk 'BEGIN {{OFS="\t"}} $2 ~ "^fin|nfe$" {{$2 = "eur"}} 1 {{print}}' {input} > {output}'''


rule gnomix_model:
    input:
        query = "intermediate/{dataset}.{build}.chr{chrom}.modelfit.vcf.gz",
        genetic_map = rules.geneticMapGnomix.output,
        reference = expand("reference_proc/{refname}.{{build}}.chr{{chrom}}.filtered_{{dataset}}.vcf.gz", refname=ref_name),
        sample_map = expand(rules.merge_eur.output, refname=ref_name),
        config = lambda wc: gconfig_local_dict[wc["dataset"]]
    output:
        'output/models/{dataset}_{build}_chr{chrom}/models/model_chm_{chrom}/model_chm_{chrom}.pkl'
    params:
        output_folder = 'output/models/{dataset}_{build}_chr{chrom}',
        phase = 'False', #True or False
    threads: 40
    resources:
        mem_mb = 4000,
        walltime = '140:00'
    container: "docker://befh/gnomix:v2"
    shell:
        '''
python3 /gnomix/gnomix.py {input.query} {params.output_folder} \
  {wildcards.chrom} {params.phase} \
  {input.genetic_map} {input.reference} {input.sample_map} \
  {input.config}
'''

gchunkdir = 'output/chunked/{dataset}_{build}_chr{chrom}_chunk{chunk}'

rule gnomix:
    input:
        query = rules.splits.output.vcf,
        tbi = rules.splits.output.tbi,
        model = rules.gnomix_model.output
    output:
        vcf = temp(gchunkdir + '/query_file_phased.vcf'),
