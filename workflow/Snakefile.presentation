from snakemake.utils import min_version
min_version("7.0")

import re
from snakemake.remote.FTP import RemoteProvider as FTPRemoteProvider
from snakemake.remote.HTTP import RemoteProvider as HTTPRemoteProvider

from urllib.request import urlopen
from urllib.error import URLError

try:
    response = urlopen('https://www.google.com/', timeout=10)
    iconnect = True
except urllib.error.URLError as ex:
    iconnect = False


configfile: "config/config.yaml"

class dummyprovider:
    def remote(string_, allow_redirects="foo", immediate_close="bar"):
        return string_

if iconnect: # and not ('nointernet' in config and config['nointernet']):
    FTP = FTPRemoteProvider()
    HTTP = HTTPRemoteProvider()
else:
    FTP = dummyprovider
    HTTP = dummyprovider

#import ipdb; ipdb.set_trace()

reporoot = "raw.githubusercontent.com/AI-sandbox/gnomix/main" 

ref_vcf = {"hg19": "reference/1000gRaw.hg19.chr{chrom}.vcf.gz",
           "hg38": "/sc/arion/scratch/gargp01/ToShare/1000Genomes_HGDP_Phased_VCFs/hgdp.tgp.gwaspy.merged.chr{chrom}.merged.cleaned.vcf.gz"} # "reference/1000gRaw.GRCh38.chr{chrom}.vcf.gz"}
ref_fasta = {"hg19": "reference/human_g1k_hg19.fasta",
             "hg38": "reference/human_g1k_GRCh38.fasta"}
ref_pops = 'reference_proc/hgdp_1kg.smap' # HTTP.remote(reporoot + "/demo/data/1000g.smap") if iconnect else ''
ref_name = "1000g"

conf = config['datasets']

def get_build(conf, dataset):
    if conf[dataset].get('impute', False):
        return 'hg38'
    else:
        return conf[dataset]['build']

def get_intype(conf, dataset):
    fname = conf[dataset]['infile']
    if re.match(r'.+\.vcf(\.b{0,1}gz)*$', fname):
        return 'vcf'
    elif re.match(r'.+\.bcf$', fname):
        return 'bcf'
    elif re.match(r'.+\.bed$', fname):
        return 'bplink'
    elif re.match(r'.+\.ped$', fname):
        return 'plink'
    else:
        raise Exception('Unrecognized file type')

def get_in(conf, dataset):
    fname = conf[dataset]['infile']
    fname = fname.format(indir=config['indir'], chrom='{chrom}') #allow
    intype = get_intype(conf, dataset)
    if intype in ['plink', 'bplink']:
        return fname[0:-4]
    else:
        return fname

def parse_chrom(chrs):
    clist = [x.split(":") for x in chrs.split(",")]
    parsed = []
    for chrs in clist:
        if len(chrs) == 2:
            chrs = [str(c) for c in range(int(chrs[0]), int(chrs[1]) + 1)]
        elif len(chrs) != 1:
            raise ValueError("Invalid chromosome list.")
        parsed += chrs
    return parsed


if 'chroms' not in config:
    CHROMS = parse_chrom('1:22')
else:
    CHROMS = parse_chrom(config['chroms'])

DATASETS = [x for x in conf.keys()]
BUILD = [get_build(conf, x) for x in DATASETS] # hg19 or hg38
array = [conf[x]['array'] for x in DATASETS]
filter_dict = {x: conf[x].get('filters', '') for x in DATASETS}
input_type_dict = {x: get_intype(conf, x) for x in DATASETS}
input_dict = {x: get_in(conf, x) for x in DATASETS}
impute_datasets = [x for x in DATASETS if conf[x].get('impute', False)]
impute_build = [conf[x]['build'] for x in DATASETS if conf[x].get('impute', False)]
if len(impute_build) > 0:
    assert len(set(impute_build)) == 1, "There can only be one build for imputation"
    impute_build = impute_build[0]
    assert impute_build in ['hg19', 'hg38']
else:
    impute_build = 'hg19'
impute_fasta = ref_fasta[impute_build]

gconfig_filename_dict = {
  k: ("config_array.yaml" if v else "config.yaml") for k, v in zip(DATASETS, array)}
gconfig_local_dict = {
  k: f'intermediate/configs/{v}' for k, v in gconfig_filename_dict.items()}

def dict_settings(setting):
    return {k: v for k, v in zip(DATASETS, setting)}

build_dict = dict_settings(BUILD)

wildcard_constraints:
    build='hg(19|38)'

rule all:
    input:
        "output/merged.vcf.gz"
        #expand('output/{dataset}_chr{chrom}/{dataset}_chr{chrom}.vcf.gz',
        #       dataset=DATASETS, chrom=CHROMS)

def get_intype(wc):
    intype_ =  wc['inputtype']
    if intype_ == 'bplink':
        return 'bfile'
    elif intype_ == 'plink':
        return 'file'
    else:
        raise Exception('Invalid input type')

def get_infile(wc):
    intype_ = wc['inputtype']
    stem = input_dict[wc['dataset']]
    if intype_ == 'bplink':
        return multiext(stem, ".bed", ".bim", ".fam")
    elif intype_ == 'plink':
        return multiext(stem, ".ped", ".map")
    else:
        raise Exception('Invalid input type')

def choose_vcf_initial(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('impute', False):
        raise Exception("Phasing not needed after imputation")
    # elif conf[ds].get('phased', False):
    #     raise Exception("Phasing not needed")
    elif intype == 'bcf':
        raise Exception("BCF not yet supported")
    elif intype == 'vcf':
        return conf[ds]['infile']
    else:
        return expand("intermediate/{{dataset}}.{{build}}.from{inputtype}.vcf.gz",
            inputtype = intype)

def choose_filter_vcf_initial(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('impute', False):
        raise Exception("Phasing not needed after imputation")
    # elif conf[ds].get('phased', False):
    #     raise Exception("Phasing not needed")
    elif intype == 'bcf':
        raise Exception("BCF not yet supported")
    elif intype == 'vcf':
        return filter_dict[ds]
    else:
        return ''

def choose_vcf_general(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if intype == 'vcf' and re.match(r'.+\{chrom\}', conf[ds]['infile']):
        return "intermediate/{dataset}.{build}.chr{chrom}.perchrom.vcf.gz"
    else:
        return rules.vcf_split.output.vcf

def choose_tbi_general(wc):
    return choose_vcf_general(wc) + '.tbi'

rule makeref:
    input:
        vcf = lambda wc: ref_vcf[wc["build"]], 
        fasta = lambda wc: ref_fasta[wc["build"]]
    output: "reference_proc/{refname}.{build}.chr{chrom}.bcf"
    conda: "envs/bcftools.yaml"
    threads: 4
    resources:
        mem_mb = 4000,
        time_min = 60
    shell:
        '''
bcftools view -Ou -c 2 {input.vcf} | \
  bcftools norm -Ou -m -any | \
  bcftools norm -Ob -o {output} -d none -f {input.fasta} && \
 bcftools index -f {output}
'''

def choose_vcf_ref(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('phased', False):
        assert intype == 'vcf', 'plink files cannot be phased and bcf files are not yet supported'
        return conf[ds]['infile']
    elif intype == 'vcf' and re.match(r'.+\{chrom\}', conf[ds]['infile']):
        return "intermediate/{dataset}.{build}.chr{chrom}.perchrom.vcf.gz"
    else:
        return rules.vcf.output.vcf

rule get_refsamp:
    input: ref_pops
    output: "reference_proc/{refname}.{build}.samplist" 
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '96:00'
    shell: r'''awk -F '\t' 'NR > 1 {{print $1}}' {input} > {output}'''

rule filter_ref:
    input:
      ref = rules.makeref.output,
      samp = choose_vcf_ref,
      ref_samples = rules.get_refsamp.output
    output: "reference_proc/{refname}.{build}.chr{chrom}.filtered_{dataset}.vcf.gz"
    conda: "envs/bcftools.yaml"
    threads: 4
    resources:
        mem_mb = 4000,
        walltime = '96:00'
    shell:
        '''
bcftools view --regions-file {input.samp} --samples-file {input.ref_samples} --force-samples -Oz -o {output} {input.ref}
bcftools index -f {output}
'''

rule geneticMapGnomix:
    input: HTTP.remote("https://storage.googleapis.com/broad-alkesgroup-public/Eagle/downloads/tables/genetic_map_{build}_withX.txt.gz") if iconnect else ''
    output: "reference_proc/genetic_map_{build}_withX.gmap"
    resources:
        mem_mb = 1000,
        time_min = 30
    shell:
        r'''
zcat {input} | \
  awk 'BEGIN {{OFS="\t"; print "#chromosome\tposition\tGenetic_Map(cM)"}} NR > 1 {{print $1,$2,$4}}' \
  > {output}
'''

def choose_vcf_gnomix(wc):
    ds = wc['dataset']
    intype = input_type_dict[ds]
    if conf[ds].get('impute', False):
        assert input_type_dict[ds] != 'vcf', 'cannot impute vcf yet'
        return 'output/imputation/data/by_chrom/{dataset}_chr{chrom}_filtered.vcf.gz',
    elif conf[ds].get('phased', False):
        assert intype == 'vcf', 'plink files cannot be phased and bcf files are not yet supported'
        return choose_vcf_general(wc)
    else:
        return "intermediate/{dataset}.{build}.chr{chrom}.phased.vcf.gz"
    
rule vcf_gnomix:
    input: choose_vcf_gnomix
    output: temp("intermediate/{dataset}.{build}.chr{chrom}.forgnomix.vcf.gz"),
    resources:
        mem_mb = 4000,
        time_min = 30
    shell: '''
cp {input} {output}
'''

rule sample_list:
    input: lambda wc: expand("intermediate/{{dataset}}.{build}.chr{chrom}.forgnomix.vcf.gz", chrom=CHROMS, build=build_dict[wc["dataset"]])
    output: "intermediate/sample_lists/{dataset}_all.txt",
    conda: "envs/bcftools.yaml"
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 30
    shell: "bcftools query -l {input[0]} > {output}"

checkpoint sample_list_split:
    input: rules.sample_list.output
    output: directory("intermediate/sample_lists/split_{dataset}")
    params:
        splitstem = "intermediate/sample_lists/split_{dataset}/split."
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 30
    shell: "mkdir -p {output} && split -l 100 -a 4 -d {input} {params.splitstem}"

rule splits:
    input:
        sample_list = "intermediate/sample_lists/split_{dataset}/split.{chunk}",
        vcf = "intermediate/{dataset}.{build}.chr{chrom}.phased.vcf.gz" 
    output:
        vcf = temp("intermediate/{dataset}.{build}.chr{chrom}.chunk{chunk}.vcf.gz"),
        tbi = temp("intermediate/{dataset}.{build}.chr{chrom}.chunk{chunk}.vcf.gz.tbi"),
    conda: "envs/bcftools.yaml"
    threads: 4
    resources:
        mem_mb = 4000,
        time_min = 30
    shell:
        '''
bcftools view --samples-file {input.sample_list} -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}
'''

rule vcf_model_fit:
    input:
        sample_list = rules.sample_list.output,
        vcf = rules.vcf_gnomix.output
    output:
        sample_list = temp("intermediate/{dataset}.{build}.chr{chrom}.modelfit.samples"),
        vcf = temp("intermediate/{dataset}.{build}.chr{chrom}.modelfit.vcf.gz"),
        tbi = temp("intermediate/{dataset}.{build}.chr{chrom}.modelfit.vcf.gz.tbi"),
    conda: "envs/bcftools.yaml"
    threads: 4
    resources:
        mem_mb = 4000,
        time_min = 30
    shell:
        '''
head -n4 {input.sample_list} > {output.sample_list}
bcftools view --samples-file {output.sample_list} -Oz -o {output.vcf} {input.vcf}
bcftools index -tf {output.vcf}
'''

#import ipdb; ipdb.set_trace()

rule download_config:
    input: HTTP.remote(f'{reporoot}/configs/{{conf}}.yaml') if iconnect else f'{reporoot}/configs/{{conf}}.yaml'
    output: 'intermediate/configs/{conf}.yaml'
    threads: 1
    resources:
        mem_mb = 4000,
        time_min = 5
